# Pono API — every setting, no value. Real values live outside the repository.

# Database: the owner role runs migrations; the app role serves requests under RLS.
PONO_DATABASE_OWNER_URL=
PONO_DATABASE_APP_URL=

# Public URL of the console (sign-in callback and cookies are built from it).
PONO_PUBLIC_URL=

# Code host: the Pono GitHub App.
PONO_GITHUB_APP_ID=
PONO_GITHUB_APP_SLUG=
PONO_GITHUB_CLIENT_ID=
PONO_GITHUB_CLIENT_SECRET=
PONO_GITHUB_PRIVATE_KEY=

# Comma-separated code host logins allowed to sign in.
PONO_ALLOWED_LOGINS=

# Fernet key encrypting stored provider credentials.
PONO_ENCRYPTION_KEY=

# Alert emails. Leave empty to keep alerts in the workshop only.
PONO_SMTP_HOST=
PONO_SMTP_PORT=
PONO_SMTP_USERNAME=
PONO_SMTP_PASSWORD=
PONO_SMTP_FROM=
